<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vědecký portál</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <div class="container">
        <h1>🔬 Vědecký portál</h1>
        <p class="subtitle">Kalkulačka, konvertory, tabulky a více</p>
        <div class="menu-grid" id="menuGrid"></div>
        <div class="footer">
            <p>© 2024 Vědecký portál | Vytvořeno s ❤️</p>
        </div>
    </div>

    <!-- Modals -->
    <div id="calculatorModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>🧮 Vědecká kalkulačka</h2>
                <button class="close-btn" onclick="closeModal('calculatorModal')">&times;</button>
            </div>
            <div class="modal-body" id="calculatorBody"></div>
        </div>
    </div>

    <div id="converterModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>🔄 Konvertor jednotek</h2>
                <button class="close-btn" onclick="closeModal('converterModal')">&times;</button>
            </div>
            <div class="modal-body" id="converterBody"></div>
        </div>
    </div>

    <div id="periodicModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>⚛️ Periodická tabulka prvků</h2>
                <button class="close-btn" onclick="closeModal('periodicModal')">&times;</button>
            </div>
            <div class="modal-body" id="periodicBody"></div>
        </div>
    </div>

    <script src="js/utils.js"></script>
    <script src="js/calculator.js"></script>
    <script src="js/converter.js"></script>
    <script src="js/periodic.js"></script>
    <script src="js/main.js"></script>
</body>
</html>
